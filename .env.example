OPENAI_BASE_URL=https://api.together.xyz/v1
OPENAI_API_KEY=your_together_api_key
OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

MCP_URL=http://localhost:8765/mcp

# Production-like DB (PostgreSQL)
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
DATABASE_URL=postgresql://monitoring:monitoring@postgres:5432/monitoring

# Dev-only: включает endpoint /api/dev/seed-demo-alerts для тестового создания алертов.
# Оставьте пустым в обычном режиме.
ALLOW_DEV_SEED_ALERTS=

# По умолчанию synthetic traces отключены.
# Включайте только для демо/отладки, чтобы сгенерировать тестовые traces из process CPU.
ENABLE_SYNTHETIC_TRACES=
